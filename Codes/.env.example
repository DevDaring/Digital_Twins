# Pratifalan configuration. Copy to `.env` (never commit `.env`) and fill in what you have.
# Every value may stay empty: with APP_MODE=demo the app runs fully offline from recorded
# fixtures in backend/fixtures/ and the twin engine always runs for real.
#
# Legacy key names are also accepted (e.g. OPENROUTER_API_KEY_1, Open_AI_2009_Key,
# DEEPSEEK_API_KEY_1, KIMI_2009_API_KEY, Grok_API_KEY, NanoGPT_2009_API_KEY,
# Fish_Audio_88_API_KEY, GEMINI_API_KEY_1); see backend/pratifalan/config.py for the full
# alias list. The canonical names below take precedence, even when EMPTY: if you keep a key
# under its legacy name, delete the empty canonical line for that provider.

# LLM providers (any subset works; fallback order is configurable)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
XAI_API_KEY=
NANOGPT_API_KEY=

# Speech
SARVAM_API_KEY=
FISH_AUDIO_API_KEY=

# Media (optional, for demo-video visuals only; not used at runtime)
FAL_KEY=
BYTEDANCE_API_KEY=

# Model routing: comma-separated provider:model lists, tried in order.
LLM_ROUTER_MODEL=openrouter:openai/gpt-5.4-mini,openrouter:google/gemini-3.8-flash,openai:gpt-5.4-mini
LLM_PLANNER_MODEL=openrouter:openai/gpt-5.4-mini,openrouter:google/gemini-3.8-flash,openrouter:anthropic/claude-sonnet-5.5,openai:gpt-5.4-mini
LLM_VISION_MODEL=openrouter:openai/gpt-5.4-mini,openrouter:google/gemini-3.8-flash,openai:gpt-5.4-mini
LLM_TRANSLATOR_MODEL=openrouter:google/gemini-3.8-flash,openrouter:openai/gpt-5.4-mini
LLM_PROVIDER_ORDER=openrouter,openai,deepseek,kimi,xai,nanogpt

# App
# APP_MODE: demo (offline, recorded fixtures) | live (real provider calls; needs keys above)
APP_MODE=demo
DEFAULT_LANGUAGE=en-IN

# Database (PostgreSQL). Local development default shown; docker compose overrides it
# to point at its own `db` service.
DATABASE_URL=postgresql+psycopg://pratibimb:pratibimb_dev_2026@localhost:5432/pratifalan

# Auth. Uncomment and set JWT_SECRET to a long random string for any shared deployment
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# Keep these two commented out to use the built-in development defaults: an EMPTY value
# would override the default (empty JWT secret / no demo accounts).
# JWT_SECRET=
# Demo login accounts seeded at start-up, format user:password,user:password.
# DEMO_USERS=

# Hosting (optional, only for the team's public demo server)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
